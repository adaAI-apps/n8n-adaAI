{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "docker volume create n8n_data"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "message": "docker pull docker.n8n.io/n8nio/n8n"
      }
    },
    {
      "method": "fs.write",
      "params": {
        "path": "app/.installed",
        "data": "installed"
      }
    },
    {
      "method": "notify",
      "params": {
        "html": "<b>Installation complete</b><br><br>Click here to start n8n!",
        "href": "./start.json"
      }
    }
  ]
}