            { icon: "fa-solid fa-rotate", text: "Perbarui", href: "update.json" },
          ]
        }
      } else {
        return [{
          icon: "fa-solid fa-power-off",
          text: "Mulai",
          href: "start.json",
        }, {
          icon: "fa-solid fa-rotate", text: "Perbarui", href: "update.json"
        }, {
          icon: "fa-solid fa-plug", text: "Instal Ulang", href: "install.json"
        }, {
          icon: "fa-solid fa-broom", text: "Reset Pabrik", href: "reset.json"
        }]
      }
    } else {
      return [
        { icon: "fa-solid fa-plug", text: "Instal", href: "install.json" },
        { icon: "fa-solid fa-rotate", text: "Perbarui", href: "update.json" }
      ]
    }
  }
}
